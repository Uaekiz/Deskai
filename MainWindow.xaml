<Window x:Class="Akai.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MPC Sampler" Height="600" Width="600"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 16 Pad için ortak görsel stil -->
        <Style TargetType="Button" x:Key="PadStyle">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="AllowDrop" Value="True"/>
            <!-- Sürükle bırak desteği -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                BorderBrush="#3E3E42" 
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Üzerine gelince hafif renk değiştirme -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Üst Kontrol Paneli -->
        <Border Grid.Row="0" Background="#181818" Padding="15,10" BorderBrush="#2A2A2E" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="AKAI" Foreground="#FF4500" FontSize="20" FontWeight="Black" Margin="0,0,6,0"/>
                    <TextBlock Text="MPC-16" Foreground="#AAAAAA" FontSize="20" FontWeight="Light"/>
                </StackPanel>

                <!-- Çıkış Cihazı Seçici -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="OUT:" Foreground="#888888" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="AudioDeviceComboBox" Width="180" 
                        Background="#252526" Foreground="#FFFFFF" BorderBrush="#FF4500" BorderThickness="1"
                        SelectionChanged="AudioDeviceComboBox_SelectionChanged" Focusable="False">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252526" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFFFFF" />
                        </ComboBox.Resources>
                    </ComboBox>
                </StackPanel>

                <!-- Kit Kaydet / Yükle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Kiti Kaydet" Click="SaveKit_Click" Background="#2D2D30" Foreground="#DDDDDD" 
                    Padding="10,5" Margin="0,0,8,0" BorderBrush="#3E3E42" Focusable="False"/>
                    <Button Content="Kiti Yükle" Click="LoadKit_Click" Background="#2D2D30" Foreground="#DDDDDD" 
                    Padding="10,5" BorderBrush="#3E3E42" Focusable="False"/>
                </StackPanel>

                <!-- Master Volume -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VOL" Foreground="#888888" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="MasterVolumeSlider" Width="90" Minimum="0" Maximum="1" Value="0.8" 
                    VerticalAlignment="Center" ValueChanged="MasterVolumeSlider_ValueChanged" Focusable="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4x4 Pad Matrisi (Aynı kalıyor) -->
        <UniformGrid Grid.Row="1" Rows="4" Columns="4" Margin="20">
            <Button Content="Pad 1 [1]" Style="{StaticResource PadStyle}" x:Name="Pad1"/>
            <Button Content="Pad 2 [2]" Style="{StaticResource PadStyle}" x:Name="Pad2"/>
            <Button Content="Pad 3 [3]" Style="{StaticResource PadStyle}" x:Name="Pad3"/>
            <Button Content="Pad 4 [4]" Style="{StaticResource PadStyle}" x:Name="Pad4"/>

            <Button Content="Pad 5 [Q]" Style="{StaticResource PadStyle}" x:Name="Pad5"/>
            <Button Content="Pad 6 [W]" Style="{StaticResource PadStyle}" x:Name="Pad6"/>
            <Button Content="Pad 7 [E]" Style="{StaticResource PadStyle}" x:Name="Pad7"/>
            <Button Content="Pad 8 [R]" Style="{StaticResource PadStyle}" x:Name="Pad8"/>

            <Button Content="Pad 9 [A]" Style="{StaticResource PadStyle}" x:Name="Pad9"/>
            <Button Content="Pad 10 [S]" Style="{StaticResource PadStyle}" x:Name="Pad10"/>
            <Button Content="Pad 11 [D]" Style="{StaticResource PadStyle}" x:Name="Pad11"/>
            <Button Content="Pad 12 [F]" Style="{StaticResource PadStyle}" x:Name="Pad12"/>

            <Button Content="Pad 13 [Z]" Style="{StaticResource PadStyle}" x:Name="Pad13"/>
            <Button Content="Pad 14 [X]" Style="{StaticResource PadStyle}" x:Name="Pad14"/>
            <Button Content="Pad 15 [C]" Style="{StaticResource PadStyle}" x:Name="Pad15"/>
            <Button Content="Pad 16 [V]" Style="{StaticResource PadStyle}" x:Name="Pad16"/>
        </UniformGrid>
    </Grid>
</Window>